# 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 .gitignore 에 포함)
DB_PASSWORD=postgres
# 공공데이터포털: 국토교통부 아파트 매매 실거래가 상세 자료 + 아파트 전월세 실거래가 자료 (같은 인증키)
MOLIT_API_KEY=
# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 뉴스 요약·원인 분석 문장화: none | openai | gemini
AI_PROVIDER=none
OPENAI_API_KEY=dummy
GEMINI_API_KEY=
# (선택) 수집 주기 — 초 분 시 일 월 요일. 기본: 실거래 매일 06:30, 뉴스 3시간마다
# APP_MONITOR_CRON=0 30 6 * * *
# APP_NEWS_CRON=0 0 */3 * * *
